{
  "name": "@local/tokenworks-git-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Session right-Sidebar Git panel: changes and diffs, commit graph, branches and tags, remote sync, and block-by-block conflict resolution.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charienustc/Tokenworks-git.git"
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "Git 面板",
    "description": "会话右侧栏的可视化 Git：改动清单与 diff、提交图、分支与标签、远程同步，以及冲突的按块解决；输入框下方还有可切换的分支胶囊。"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
