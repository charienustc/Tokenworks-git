{
  "name": "@local/tokenworks-git-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Session right-Sidebar Git panel: changes, diffs, commit graph, staging and commit.",
  "scripts": {
    "smoke": "node tools/smoke.mjs",
    "client-smoke": "node tools/client-smoke.mjs",
    "test": "node tools/smoke.mjs && node tools/client-smoke.mjs"
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "Git 面板",
    "description": "会话右侧栏的可视化 Git：改动清单、差异查看、提交图、暂存与提交。"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "icon.svg",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
